# ────────────── Python ──────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.log

# Virtual Environments
env/
venv/
.venv/
ENV/
.Python

# Python Packaging
*.egg-info/
*.egg
dist/
build/

# ────────────── Jupyter ──────────────
.ipynb_checkpoints/

# ────────────── VS Code ──────────────
.vscode/

# ────────────── Operating System Files ──────────────
.DS_Store
Thumbs.db

# ────────────── Node / Frontend ──────────────
node_modules/

# ────────────── Large Data / Private Files ──────────────
processed_data/*.csv
feature_engineered_data/*.csv
original_data/*.csv

# ────────────── Environment and Secrets ──────────────
.env
.env.*
!.env.example

# ────────────── Test Cache ──────────────
.pytest_cache/

# ────────────── Frontend Builds (Next.js) ──────────────
frontend/.next/
frontend/out/
frontend/node_modules/

# ────────────── Generated Runtime Reports ──────────────
# Prevents future generated artifacts from being tracked.
# Existing tracked files in reports/ are not affected by this rule.
reports/*.html
reports/*.pdf
reports/*.txt
reports/*.csv
reports/*.json

# ────────────── Generated Model Reports ──────────────
model_reports/*.csv

# ────────────── Generated Model Artifacts ──────────────
models/**/*.pkl
models/**/*.joblib
*.pkl
*.joblib

# ────────────── Log Directory ──────────────
logs/
