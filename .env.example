# AI AutoML Intelligence Platform - Environment Configuration
#
# This file contains placeholder values only.
# Copy this file to .env and fill in your local values.
# Never commit a .env file with real credentials.
#
# ─────────────────────────────────────────────────────────────
# Ollama Local LLM
# Ollama must be running locally for RAG queries and AI insights.
# Install: https://ollama.com
# Default port is 11434. Change only if you have relocated the service.
# ─────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral

# ─────────────────────────────────────────────────────────────
# CORS Configuration
# Restrict this to your frontend origin before any public deployment.
# The wildcard (*) is only appropriate for local development.
# ─────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Backend Server
# ─────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ─────────────────────────────────────────────────────────────
# Frontend
# Point the Next.js frontend at the running backend API.
# ─────────────────────────────────────────────────────────────
FRONTEND_API_BASE_URL=http://localhost:8000

# ─────────────────────────────────────────────────────────────
# Output Directories
# These are local development defaults. Adjust for your environment.
# ─────────────────────────────────────────────────────────────
REPORT_OUTPUT_DIR=reports
MODEL_OUTPUT_DIR=models
DATA_OUTPUT_DIR=processed_data
RAG_INDEX_DIR=data_1

# ─────────────────────────────────────────────────────────────
# Security Reminder
# Do not add real API keys, tokens, or passwords to this file.
# If you add third-party service integrations, document placeholder
# variable names here so other developers know what to configure.
# Example (never fill in real values in this file):
#   OPENAI_API_KEY=your-key-here
#   GROQ_API_KEY=your-key-here
# ─────────────────────────────────────────────────────────────
